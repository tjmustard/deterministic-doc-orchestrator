# --- DDO Project Ignores ---

# HACF hyper-* toolchain (skills, commands, scripts — not project code)
# Matches: .agents/skills/hyper-*/, .claude/commands/hyper-*.md, .agents/scripts/hyper_*.py, etc.
hyper-*
hyper_*
hypergraph_*

# Spec and test artifacts (Surgical .gitignore Matrix, SuperPRD §5 / Red Team #8).
# Keep runtime/working dirs ignored (structure preserved via .gitkeep). The tracked
# dirs — spec/compiled, spec/process, tests/{unit,integration,fixtures} — are
# committable and intentionally NOT listed here. tests/fixtures content is gated by
# the human sign-off guard (scripts/fixture_signoff_guard.py), not by .gitignore.
spec/active/*
!spec/active/.gitkeep
#spec/archive/*
!spec/archive/.gitkeep
tests/candidate_outputs/*
!tests/candidate_outputs/.gitkeep

# DDO generated output
Documents/

# Python / uv
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env

# OS-specific
.DS_Store
Thumbs.db

# Runtime artifacts
*.log
*.swp
tmp/
